{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "app": "Splitbo",
    "version": "1.0.0",
    "note": "PRIMITIVE tokens are raw values. SEMANTIC tokens reference primitives. UI code consumes SEMANTIC only."
  },

  "primitive": {
    "color": {
      "green": {
        "50":  { "$value": "#F2FAE3", "$type": "color" },
        "100": { "$value": "#EEF7D9", "$type": "color" },
        "200": { "$value": "#D5EEA6", "$type": "color" },
        "300": { "$value": "#BCE573", "$type": "color" },
        "400": { "$value": "#A3DC40", "$type": "color" },
        "500": { "$value": "#9CD246", "$type": "color", "$description": "Splitbo brand primary" },
        "600": { "$value": "#7BA832", "$type": "color", "$description": "Pressed / hover state" },
        "700": { "$value": "#5A7E22", "$type": "color" },
        "800": { "$value": "#3A5414", "$type": "color" },
        "900": { "$value": "#1A2A06", "$type": "color" }
      },
      "neutral": {
        "0":    { "$value": "#FFFFFF", "$type": "color" },
        "50":   { "$value": "#F5F5F5", "$type": "color" },
        "100":  { "$value": "#E0E0E0", "$type": "color" },
        "200":  { "$value": "#BDBDBD", "$type": "color" },
        "300":  { "$value": "#9E9E9E", "$type": "color" },
        "400":  { "$value": "#757575", "$type": "color" },
        "500":  { "$value": "#666666", "$type": "color" },
        "600":  { "$value": "#424242", "$type": "color" },
        "700":  { "$value": "#2A2A2A", "$type": "color" },
        "800":  { "$value": "#1E1E1E", "$type": "color" },
        "850":  { "$value": "#1A1A1A", "$type": "color" },
        "900":  { "$value": "#141414", "$type": "color" },
        "950":  { "$value": "#0D0D0D", "$type": "color" },
        "1000": { "$value": "#000000", "$type": "color" }
      },
      "positive": {
        "50":  { "$value": "#D1FAE5", "$type": "color" },
        "100": { "$value": "#A7F3D0", "$type": "color" },
        "500": { "$value": "#22C55E", "$type": "color", "$description": "Owed to you" },
        "700": { "$value": "#15803D", "$type": "color" }
      },
      "negative": {
        "50":  { "$value": "#FFEDD5", "$type": "color" },
        "500": { "$value": "#F97316", "$type": "color", "$description": "You owe — warm orange, NOT red" },
        "700": { "$value": "#C2410C", "$type": "color" }
      },
      "warning": {
        "50":  { "$value": "#FEF3C7", "$type": "color" },
        "500": { "$value": "#F59E0B", "$type": "color" },
        "700": { "$value": "#B45309", "$type": "color" }
      },
      "error": {
        "50":  { "$value": "#FEE2E2", "$type": "color" },
        "500": { "$value": "#DC2626", "$type": "color", "$description": "Destructive actions only" },
        "700": { "$value": "#991B1B", "$type": "color" }
      }
    },

    "fontSize": {
      "xs":  { "$value": 11, "$type": "number", "$description": "Caption" },
      "sm":  { "$value": 13, "$type": "number", "$description": "Label" },
      "md":  { "$value": 14, "$type": "number", "$description": "Body M" },
      "lg":  { "$value": 16, "$type": "number", "$description": "Body L" },
      "xl":  { "$value": 18, "$type": "number", "$description": "H3" },
      "2xl": { "$value": 22, "$type": "number", "$description": "H2" },
      "3xl": { "$value": 28, "$type": "number", "$description": "H1" },
      "4xl": { "$value": 36, "$type": "number", "$description": "Display L" },
      "5xl": { "$value": 48, "$type": "number", "$description": "Display XL" }
    },

    "fontWeight": {
      "regular":    { "$value": 400, "$type": "number" },
      "medium":     { "$value": 500, "$type": "number" },
      "semibold":   { "$value": 600, "$type": "number" },
      "bold":       { "$value": 700, "$type": "number" },
      "extrabold":  { "$value": 800, "$type": "number" }
    },

    "lineHeight": {
      "tight":  { "$value": 1.2, "$type": "number" },
      "normal": { "$value": 1.5, "$type": "number" },
      "relaxed":{ "$value": 1.75, "$type": "number" }
    },

    "space": {
      "1":  { "$value": 4,   "$type": "number" },
      "2":  { "$value": 8,   "$type": "number" },
      "3":  { "$value": 12,  "$type": "number" },
      "4":  { "$value": 16,  "$type": "number" },
      "5":  { "$value": 20,  "$type": "number" },
      "6":  { "$value": 24,  "$type": "number" },
      "8":  { "$value": 32,  "$type": "number" },
      "10": { "$value": 40,  "$type": "number" },
      "12": { "$value": 48,  "$type": "number" },
      "16": { "$value": 64,  "$type": "number" },
      "20": { "$value": 80,  "$type": "number" }
    },

    "radius": {
      "none": { "$value": 0,   "$type": "number" },
      "xs":   { "$value": 4,   "$type": "number" },
      "sm":   { "$value": 8,   "$type": "number" },
      "md":   { "$value": 12,  "$type": "number" },
      "lg":   { "$value": 16,  "$type": "number" },
      "xl":   { "$value": 24,  "$type": "number" },
      "full": { "$value": 999, "$type": "number" }
    },

    "duration": {
      "instant": { "$value": 0,   "$type": "number" },
      "fast":    { "$value": 150, "$type": "number" },
      "normal":  { "$value": 250, "$type": "number" },
      "slow":    { "$value": 400, "$type": "number" }
    }
  },

  "semantic": {
    "light": {
      "color": {
        "background": {
          "default":   { "$value": "{primitive.color.neutral.0}",   "$type": "color" },
          "subtle":    { "$value": "{primitive.color.neutral.50}",  "$type": "color" },
          "emphasis":  { "$value": "{primitive.color.green.500}",   "$type": "color" }
        },
        "surface": {
          "default":   { "$value": "{primitive.color.neutral.0}",   "$type": "color" },
          "raised":    { "$value": "{primitive.color.neutral.50}",  "$type": "color" },
          "overlay":   { "$value": "{primitive.color.neutral.0}",   "$type": "color" }
        },
        "text": {
          "primary":   { "$value": "{primitive.color.neutral.950}", "$type": "color" },
          "secondary": { "$value": "{primitive.color.neutral.500}", "$type": "color" },
          "disabled":  { "$value": "{primitive.color.neutral.300}", "$type": "color" },
          "onPrimary": { "$value": "{primitive.color.neutral.1000}","$type": "color" },
          "inverse":   { "$value": "{primitive.color.neutral.0}",   "$type": "color" }
        },
        "border": {
          "default":   { "$value": "{primitive.color.neutral.100}", "$type": "color" },
          "focus":     { "$value": "{primitive.color.green.500}",   "$type": "color" },
          "error":     { "$value": "{primitive.color.error.500}",   "$type": "color" }
        },
        "brand": {
          "primary":   { "$value": "{primitive.color.green.500}",   "$type": "color" },
          "primaryDk": { "$value": "{primitive.color.green.600}",   "$type": "color" },
          "primaryLt": { "$value": "{primitive.color.green.100}",   "$type": "color" }
        },
        "semantic": {
          "positive":  { "$value": "{primitive.color.positive.500}","$type": "color" },
          "positiveBg":{ "$value": "{primitive.color.positive.50}", "$type": "color" },
          "negative":  { "$value": "{primitive.color.negative.500}","$type": "color" },
          "negativeBg":{ "$value": "{primitive.color.negative.50}", "$type": "color" },
          "warning":   { "$value": "{primitive.color.warning.500}", "$type": "color" },
          "warningBg": { "$value": "{primitive.color.warning.50}",  "$type": "color" },
          "error":     { "$value": "{primitive.color.error.500}",   "$type": "color" },
          "errorBg":   { "$value": "{primitive.color.error.50}",    "$type": "color" }
        }
      }
    },
    "dark": {
      "color": {
        "background": {
          "default":   { "$value": "{primitive.color.neutral.1000}", "$type": "color" },
          "subtle":    { "$value": "{primitive.color.neutral.900}",  "$type": "color" },
          "emphasis":  { "$value": "{primitive.color.green.500}",    "$type": "color" }
        },
        "surface": {
          "default":   { "$value": "{primitive.color.neutral.900}",  "$type": "color" },
          "raised":    { "$value": "{primitive.color.neutral.850}",  "$type": "color" },
          "overlay":   { "$value": "{primitive.color.neutral.800}",  "$type": "color" }
        },
        "text": {
          "primary":   { "$value": "{primitive.color.neutral.0}",    "$type": "color" },
          "secondary": { "$value": "{primitive.color.neutral.300}",  "$type": "color" },
          "disabled":  { "$value": "{primitive.color.neutral.600}",  "$type": "color" },
          "onPrimary": { "$value": "{primitive.color.neutral.1000}", "$type": "color" },
          "inverse":   { "$value": "{primitive.color.neutral.950}",  "$type": "color" }
        },
        "border": {
          "default":   { "$value": "{primitive.color.neutral.700}",  "$type": "color" },
          "focus":     { "$value": "{primitive.color.green.500}",    "$type": "color" },
          "error":     { "$value": "{primitive.color.error.500}",    "$type": "color" }
        },
        "brand": {
          "primary":   { "$value": "{primitive.color.green.500}",    "$type": "color" },
          "primaryDk": { "$value": "{primitive.color.green.600}",    "$type": "color" },
          "primaryLt": { "$value": "{primitive.color.green.900}",    "$type": "color" }
        },
        "semantic": {
          "positive":  { "$value": "{primitive.color.positive.500}", "$type": "color" },
          "positiveBg":{ "$value": "{primitive.color.positive.50}",  "$type": "color", "$description": "Use at 15% opacity on dark" },
          "negative":  { "$value": "{primitive.color.negative.500}", "$type": "color" },
          "negativeBg":{ "$value": "{primitive.color.negative.50}",  "$type": "color" },
          "warning":   { "$value": "{primitive.color.warning.500}",  "$type": "color" },
          "warningBg": { "$value": "{primitive.color.warning.50}",   "$type": "color" },
          "error":     { "$value": "{primitive.color.error.500}",    "$type": "color" },
          "errorBg":   { "$value": "{primitive.color.error.50}",     "$type": "color" }
        }
      }
    },
    "shared": {
      "space": {
        "inset": {
          "xs":  { "$value": "{primitive.space.2}",  "$type": "number" },
          "sm":  { "$value": "{primitive.space.3}",  "$type": "number" },
          "md":  { "$value": "{primitive.space.4}",  "$type": "number" },
          "lg":  { "$value": "{primitive.space.6}",  "$type": "number" },
          "xl":  { "$value": "{primitive.space.8}",  "$type": "number" }
        },
        "stack": {
          "xs":  { "$value": "{primitive.space.1}",  "$type": "number" },
          "sm":  { "$value": "{primitive.space.2}",  "$type": "number" },
          "md":  { "$value": "{primitive.space.4}",  "$type": "number" },
          "lg":  { "$value": "{primitive.space.6}",  "$type": "number" },
          "xl":  { "$value": "{primitive.space.10}", "$type": "number" }
        },
        "inline": {
          "xs":  { "$value": "{primitive.space.1}",  "$type": "number" },
          "sm":  { "$value": "{primitive.space.2}",  "$type": "number" },
          "md":  { "$value": "{primitive.space.3}",  "$type": "number" },
          "lg":  { "$value": "{primitive.space.4}",  "$type": "number" },
          "xl":  { "$value": "{primitive.space.6}",  "$type": "number" }
        }
      },
      "radius": {
        "control":   { "$value": "{primitive.radius.md}",   "$type": "number", "$description": "Buttons, inputs, chips" },
        "card":      { "$value": "{primitive.radius.lg}",   "$type": "number", "$description": "Cards, bottom sheets" },
        "modal":     { "$value": "{primitive.radius.xl}",   "$type": "number", "$description": "Modals, dialogs" },
        "pill":      { "$value": "{primitive.radius.full}", "$type": "number", "$description": "Pills, badges, FAB" }
      },
      "motion": {
        "duration": {
          "fast":   { "$value": "{primitive.duration.fast}",   "$type": "number" },
          "normal": { "$value": "{primitive.duration.normal}", "$type": "number" },
          "slow":   { "$value": "{primitive.duration.slow}",   "$type": "number" }
        }
      },
      "minTouchTarget": { "$value": 44, "$type": "number", "$description": "WCAG 2.2 AA minimum hit target (dp)" }
    }
  }
}
