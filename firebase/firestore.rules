rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: only the owner can read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Groups: any member can read; only members can write
    match /groups/{groupId} {
      allow read: if request.auth != null &&
                     request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null &&
                       request.auth.uid in request.resource.data.memberIds;
      allow update, delete: if request.auth != null &&
                               request.auth.uid in resource.data.memberIds;
    }

    // Expenses: members of the parent group can read/write
    match /groups/{groupId}/expenses/{expenseId} {
      allow read, write: if request.auth != null &&
                            request.auth.uid in
                            get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // Personal expenses (no group)
    match /expenses/{expenseId} {
      allow read, write: if request.auth != null &&
                            request.auth.uid == resource.data.paidBy;
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.paidBy;
    }

    // Balances: only the owner can read their balances
    match /balances/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
