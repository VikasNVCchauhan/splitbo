rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(groupData) {
      return request.auth.uid in groupData.memberIds;
    }

    // Self-join: authenticated user is adding only their own UID to memberIds
    function isSelfJoin(resource, request) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && !resource.data.memberIds.hasAll([request.auth.uid]);
    }

    // ── Production collections ─────────────────────────────────────────────────

    // Users — own profile is fully private, but display name + avatar are
    // readable by any signed-in user (needed for showing member names in groups).
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/contacts/{contactId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read:   if isSignedIn() && isMember(resource.data);
      allow create: if isSignedIn() && isMember(request.resource.data);
      // Members can update. Anyone signed-in can self-join (for QR invite flow).
      allow update: if isSignedIn() && (isMember(resource.data) || isSelfJoin(resource, request));
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /groups/{groupId}/expenses/{expenseId} {
      allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // Top-level expenses (legacy / activity-feed cross-group queries)
    match /expenses/{expenseId} {
      allow read:   if isSignedIn() && request.auth.uid == resource.data.paidBy;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.paidBy;
    }

    // Balances are server-managed — clients may only read their own.
    match /balances/{balanceId} {
      allow read: if isSignedIn() && request.auth.uid == balanceId;
      allow write: if false; // Cloud Functions only
    }

    // Invite codes — readable publicly (needed before auth on QR join screen).
    // Only authenticated users (including anonymous) may create or accept.
    match /invites/{code} {
      allow read:   if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted';
    }

    // ── Development collections (debug builds use dev_ prefix) ────────────────

    match /dev_users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /dev_users/{userId}/contacts/{contactId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /dev_groups/{groupId} {
      allow read:   if isSignedIn() && isMember(resource.data);
      allow create: if isSignedIn() && isMember(request.resource.data);
      allow update: if isSignedIn() && (isMember(resource.data) || isSelfJoin(resource, request));
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /dev_groups/{groupId}/expenses/{expenseId} {
      allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/dev_groups/$(groupId)).data.memberIds;
    }

    match /dev_expenses/{expenseId} {
      allow read:   if isSignedIn() && request.auth.uid == resource.data.paidBy;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.paidBy;
    }

    match /dev_balances/{balanceId} {
      allow read: if isSignedIn() && request.auth.uid == balanceId;
      allow write: if false;
    }

    match /dev_invites/{code} {
      allow read:   if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted';
    }

  }
}
