rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Production collections ──────────────────────────────────────────────

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read: if request.auth != null &&
                     request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null &&
                       request.auth.uid in request.resource.data.memberIds;
      allow update, delete: if request.auth != null &&
                               request.auth.uid in resource.data.memberIds;
    }

    match /groups/{groupId}/expenses/{expenseId} {
      allow read, write: if request.auth != null &&
                            request.auth.uid in
                            get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    match /expenses/{expenseId} {
      allow read: if request.auth != null &&
                     request.auth.uid == resource.data.paidBy;
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.paidBy;
    }

    // Balances are server-managed — clients may only read their own.
    match /balances/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // ── Development collections (debug builds use dev_ prefix) ────────────

    match /dev_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /dev_groups/{groupId} {
      allow read: if request.auth != null &&
                     request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null &&
                       request.auth.uid in request.resource.data.memberIds;
      allow update, delete: if request.auth != null &&
                               request.auth.uid in resource.data.memberIds;
    }

    match /dev_groups/{groupId}/expenses/{expenseId} {
      allow read, write: if request.auth != null &&
                            request.auth.uid in
                            get(/databases/$(database)/documents/dev_groups/$(groupId)).data.memberIds;
    }

    match /dev_expenses/{expenseId} {
      allow read: if request.auth != null &&
                     request.auth.uid == resource.data.paidBy;
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.paidBy;
    }

    match /dev_balances/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
  }
}
